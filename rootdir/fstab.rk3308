# block device                                      mount point  type  mount options              fs_mgr options
/dev/block/platform/ff490000.mmc/by-name/cache      /cache       ext4  noatime,nosuid,nodev        wait,check,formattable
/dev/block/platform/ff490000.mmc/by-name/userdata   /data        ext4  noatime,nosuid,nodev        wait,check,formattable
/dev/block/platform/ff490000.mmc/by-name/misc       /misc        emmc  defaults                   defaults
/dev/block/zram0                                   none        swap  defaults                   wait,zramsize=134217728,max_comp_streams=-1
