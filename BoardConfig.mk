TARGET_ARCH := arm
TARGET_ARCH_VARIANT := armv7-a-neon
TARGET_CPU_VARIANT := cortex-a53
TARGET_CPU_ABI := armeabi-v7a
TARGET_CPU_ABI2 := armeabi
TARGET_USES_64_BIT_BINDER := true

TARGET_BOARD_PLATFORM := rk3308
TARGET_BOOTLOADER_BOARD_NAME := sogou_e1
TARGET_NO_BOOTLOADER := true
# The same external BSP inputs feed both legacy boot images.
ifneq ($(strip $(SOGOU_E1_KERNEL)$(SOGOU_E1_RESOURCE)),)
ifeq ($(strip $(SOGOU_E1_KERNEL)),)
$(error Set SOGOU_E1_KERNEL to the BSP Image)
endif
ifeq ($(strip $(SOGOU_E1_RESOURCE)),)
$(error Set SOGOU_E1_RESOURCE to the BSP resource image)
endif
TARGET_NO_KERNEL := false
BOARD_MKBOOTIMG_ARGS += --second $(SOGOU_E1_RESOURCE)
BOARD_KERNEL_CMDLINE := androidboot.hardware=rk3308 console=ttyFIQ0 androidboot.console=ttyFIQ0
else
TARGET_NO_KERNEL := true
endif
BOARD_USES_FULL_RECOVERY_IMAGE := true
TARGET_RECOVERY_FSTAB := device/rockchip/rk3308/rootdir/recovery.fstab

TARGET_USES_HWC2 := false
TARGET_RUNNING_WITHOUT_SYNC_FRAMEWORK := true
USE_OPENGL_RENDERER := true
USE_CAMERA_STUB := true

TARGET_COPY_OUT_VENDOR := vendor
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USES_MKE2FS := true
BOARD_SYSTEMIMAGE_PARTITION_SIZE := 2147483648
BOARD_VENDORIMAGE_PARTITION_SIZE := 536870912
BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_CACHEIMAGE_PARTITION_SIZE := 268435456
BOARD_CACHEIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_BOOTIMAGE_PARTITION_SIZE := 20971520
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 33554432
BOARD_FLASH_BLOCK_SIZE := 4096

DEVICE_MANIFEST_FILE := device/rockchip/rk3308/manifest.xml
BOARD_SEPOLICY_DIRS += device/rockchip/rk3308/sepolicy
